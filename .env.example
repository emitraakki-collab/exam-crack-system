# Exam Crack System - Environment Variables
# Copy this file to .env.local and fill in the values

# ─── Database ───────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Razorpay ──────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Download Security ─────────────────────────────────
# Generate a strong random string (min 32 chars)
DOWNLOAD_TOKEN_SECRET="change-this-to-a-very-strong-random-secret-string-min-32-chars"

# ─── Admin Panel ───────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_SESSION_SECRET="generate-another-strong-random-string-min-32-chars"

# ─── Site Configuration ───────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ─── Support ──────────────────────────────────────────
SUPPORT_EMAIL="support@example.com"
SUPPORT_WHATSAPP="+91XXXXXXXXXX"
